{
  "pages": [
    {
      "path": "pages/home/index",
      "style": {
        "navigationStyle": "custom",
        "backgroundColor": "#ffffff",
        "navigationBarTitleText": "首页",
        "navigationBarTextStyle": "black"
      }
    },
    {
      "path": "pages/driving/index",
      "style": {
        "navigationBarTitleText": "导航"
      }
    },
    {
      "path": "pages/me/index",
      "style": {
        "navigationBarTitleText": "我的"
      }
    }
  ],
  "condition": { // 模式配置，仅开发期间生效
    "current": 1, // 当前激活的模式（list 的索引项）
    "list": [
      {
        "name": "login", // 模式名称
        "path": "pages/me/login/index", // 启动页面，必选
        "query": "interval=4000&autoplay=false" // 启动参数，在页面的onLoad函数里面得到。
      },
      {
        "name": "home",
        "path": "pages/home/index"
      }
    ]
  },
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "智泊无忧",
    "navigationBarBackgroundColor": "#ffffff",
    "backgroundColor": "#f3f5f9"
  },
  "tabBar": {
    "color": "#909399",
    "selectedColor": "#303133",
    "list": [
      {
        "pagePath": "pages/home/index"
      },
      {
        "pagePath": "pages/driving/index"
      },
      {
        "pagePath": "pages/me/index"
      }
    ]
  },
  "easycom": {
    "autoscan": true,
    "custom": {
      "^u-(.*)": "uview-plus/components/u-$1/u-$1.vue"
    }
  },
  "subPackages": [
    {
      "root": "pages/home/parkinglot",
      "pages": [
        {
          "path": "detail",
          "style": {
            "navigationBarTitleText": "停车场详细"
          }
        }
      ]
    },
    {
      "root": "pages/me/user",
      "pages": [
        {
          "path": "index",
          "style": {
            "navigationBarTitleText": "用户中心"
          }
        },
        {
          "path": "order/index",
          "style": {
            "navigationBarTitleText": "订单"
          }
        },
        {
          "path": "vehicle/index",
          "style": {
            "navigationBarTitleText": "车辆"
          }
        },
        {
          "path": "login/index",
          "style": {
            "navigationBarTitleText": "用户登录"
          }
        }
      ]
    },
    {
      "root": "pages/me/merchant",
      "pages": [
        {
          "path": "index",
          "style": {
            "navigationBarTitleText": "商户中心"
          }
        },
        {
          "path": "login/index",
          "style": {
            "navigationBarTitleText": "商家登录"
          }
        }
      ]
    }
  ],
  "preloadRule": {
  }
}
