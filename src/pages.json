{
  "pages": [
    {
      "path": "pages/home/index"
    },
    {
      "path": "pages/driving/index"
    },
    {
      "path": "pages/me/index"
    },
    {
      "path": "pages/me/user/index"
    },
    {
      "path": "pages/me/merchant/index"
    }
  ],
  "condition": { // 模式配置，仅开发期间生效
    "current": 1, // 当前激活的模式（list 的索引项）
    "list": [
      {
        "name": "login", // 模式名称
        "path": "pages/me/login/index", // 启动页面，必选
        "query": "interval=4000&autoplay=false" // 启动参数，在页面的onLoad函数里面得到。
      },
      {
        "name": "home",
        "path": "pages/home/index"
      }
    ]
  },
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "智泊无忧",
    "navigationBarBackgroundColor": "#ffffff",
    "navigationStyle": "custom",
    "backgroundColor": "#f3f5f9"
  },
  "tabBar": {
    "color": "#909399",
    "selectedColor": "#303133",
    "list": [
      {
        "pagePath": "pages/home/index"
      },
      {
        "pagePath": "pages/driving/index"
      },
      {
        "pagePath": "pages/me/user/index"
      },
      {
        "pagePath": "pages/me/merchant/index"
      }
    ]
  },
  "easycom": {
    "autoscan": true,
    "custom": {
      "^u-(.*)": "uview-plus/components/u-$1/u-$1.vue"
    }
  },
  "subPackages": [
    {
      "root": "pages/me/user/order",
      "pages": [
        {
          "path": "index"
        }
      ]
    },
    {
      "root": "pages/me/user/vehicle",
      "pages": [
        {
          "path": "index"
        }
      ]
    },
    {
      "root": "pages/home/parkinglot",
      "pages": [
        {
          "path": "detail"
        }
      ]
    }
  ],
  "preloadRule": {
  }
}
