    "type-check": "vue-tsc --noEmit",
    "eslint": "eslint \"src/**/*.{js,jsx,ts,tsx,vue}\" --fix --ignore-pattern \"src/uni_modules/\"",
    "stylelint": "stylelint \"src/**/*.{vue,scss,css}\" --fix",
    "prepare": "husky"
